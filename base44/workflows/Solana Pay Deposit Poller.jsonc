{
  "description": "Polls the admin Solana wallet every 5 minutes for incoming USDC transfers matching pending Solana Pay deposit requests, and credits the user's balance. Safety net for deposits made while the user's browser tab is closed.",
  "name": "Solana Pay Deposit Poller",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "solana_pay_poller",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "poll": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pollSolanaPayDeposits",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Poll Solana Pay deposits",
            "description": "Match & credit pending USDC transfers"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Dhaka",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}