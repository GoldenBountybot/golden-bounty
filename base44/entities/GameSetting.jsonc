{
  "name": "GameSetting",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Slug matching the game route, or '*' for the global default"
    },
    "game_name": {
      "type": "string"
    },
    "rtp": {
      "type": "number",
      "default": 50,
      "description": "Winning chance percentage 0-100 the game biases toward"
    },
    "demo_rtp": {
      "type": "number",
      "default": 50,
      "description": "Winning chance percentage 0-100 used while Demo balance mode is active"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "min_bet": {
      "type": "number",
      "default": 1
    },
    "max_bet": {
      "type": "number",
      "default": 500
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description of this game"
    }
  },
  "required": [
    "game_id",
    "game_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}