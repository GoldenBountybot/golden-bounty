{
  "name": "GameSetting",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Slug matching the game route, or '*' for the global default"
    },
    "game_name": {
      "type": "string"
    },
    "rtp": {
      "type": "number",
      "default": 50,
      "description": "Winning chance percentage 0-100 the game biases toward"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "min_bet": {
      "type": "number",
      "default": 1
    },
    "max_bet": {
      "type": "number",
      "default": 500
    }
  },
  "required": [
    "game_id",
    "game_name"
  ]
}