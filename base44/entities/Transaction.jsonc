{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "withdraw",
        "bonus",
        "adjustment"
      ],
      "default": "deposit"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "completed"
      ],
      "default": "pending"
    },
    "method": {
      "type": "string",
      "default": "stripe"
    },
    "reference": {
      "type": "string",
      "description": "Stripe charge / session id"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type",
    "amount",
    "status"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}