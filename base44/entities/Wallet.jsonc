{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 one wallet per user"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Authoritative casino wallet balance. Users can only read this; only backend functions (service role) and admins can modify it."
    },
    "wager_remaining": {
      "type": "number",
      "default": 0,
      "description": "Deposited funds still requiring play-through before withdrawal."
    },
    "staked_amount": {
      "type": "number",
      "default": 0,
      "description": "Balance currently locked in the Stack (cannot be used or withdrawn until it unlocks)."
    },
    "staked_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the current Stack lock started."
    },
    "last_profit_claim": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last claimed Stack profit day."
    },
    "cashback_claimed_loss": {
      "type": "number",
      "default": 0,
      "description": "Cumulative net loss (from deposited funds) already cashbacked, so the same loss can't be double-claimed. Authoritative source \u2014 moved from the User entity (which users could write via updateMe) to here so users can't reset it to 0 to re-claim cashback."
    },
    "banned": {
      "type": "boolean",
      "default": false,
      "description": "Authoritative ban flag. When true the user is blocked from the app and all money operations. Moved from the User entity (which users could write via updateMe) to here so users can't unban themselves. Admins set this via adminAdjustWallet."
    },
    "rtp": {
      "type": "number",
      "description": "Per-player winning-chance override (0-100). When set, overrides global/per-game RTP for this player across all games. Moved from the User entity (which users could write via updateMe to rig games) to here so only admins can set it."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}