{
  "name": "PlayerActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "bet": {
      "type": "number",
      "default": 0
    },
    "win": {
      "type": "number",
      "default": 0
    },
    "outcome": {
      "type": "string",
      "enum": [
        "win",
        "loss",
        "push"
      ],
      "default": "loss"
    },
    "multiplier": {
      "type": "number",
      "default": 0,
      "description": "Round odds / multiplier the player cashed out at or the round busted at"
    }
  },
  "required": [
    "user_id",
    "game_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}