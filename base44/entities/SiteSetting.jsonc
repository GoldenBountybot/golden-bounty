{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique key identifying the setting, e.g. stack_banner"
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded image URL for this setting"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description of this setting"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}