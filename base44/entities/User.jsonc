{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "uid": {
      "type": "string",
      "description": "10-digit unique player id"
    },
    "username": {
      "type": "string",
      "description": "Display username chosen by the player"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the user"
    },
    "pay_pin": {
      "type": "string",
      "description": "4-digit withdrawal (Pay) PIN set by the player. Required to confirm agent and USDT withdrawals."
    },
    "rtp": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Per-player winning chance override (0-100). When set, overrides global/per-game RTP for this player across all games."
    },
    "staked_amount": {
      "type": "number",
      "default": 0,
      "description": "Display mirror of Wallet.staked_amount (authoritative source is the Wallet entity). Kept for admin display compatibility."
    },
    "staked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Display mirror of Wallet.staked_at."
    },
    "last_profit_claim": {
      "type": "string",
      "format": "date-time",
      "description": "Display mirror of Wallet.last_profit_claim."
    },
    "promo_code": {
      "type": "string",
      "description": "This player's unique referral promo code (shareable). New players who redeem it receive a $1 Stack bonus."
    },
    "referred_by": {
      "type": "string",
      "description": "User id of the referrer whose promo code this player redeemed. Empty until a code is used."
    },
    "promo_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this player has already redeemed a promo code for the $1 Stack bonus."
    },
    "referral_earnings": {
      "type": "number",
      "default": 0,
      "description": "Total 5% referral commission earned from referred players' deposits."
    },
    "bounty_allocation": {
      "type": "number",
      "default": 0,
      "description": "Claimed BOUNTY token allocation persisted after claiming on the Airdrop page."
    },
    "bounty_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last BOUNTY airdrop claim."
    },
    "referral_bounty": {
      "type": "number",
      "default": 0,
      "description": "BOUNTY tokens earned from referral commissions (2 BOUNTY per 1 USDT commission)."
    },
    "task_bounty": {
      "type": "number",
      "default": 0,
      "description": "BOUNTY tokens earned from completing social tasks (X follow, Telegram subscribe, etc.)."
    },
    "claimed_tasks": {
      "type": "string",
      "default": "",
      "description": "Comma-separated list of task names the user has already claimed (e.g. 'x,telegram')."
    },
    "banned": {
      "type": "boolean",
      "default": false,
      "description": "When true, the user is blocked from accessing the app. Set by admins from the Players panel."
    },
    "promo_welcome_seen": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has already visited the PromoWelcome page. Returning users (logout \u2192 re-register with same email/Google) are redirected to home instead of seeing the promo code input again."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}