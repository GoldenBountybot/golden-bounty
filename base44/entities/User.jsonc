{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "uid": {
      "type": "string",
      "description": "10-digit unique player id"
    },
    "username": {
      "type": "string",
      "description": "Display username chosen by the player"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the user"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Casino wallet balance managed by the admin"
    },
    "rtp": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Per-player winning chance override (0-100). When set, overrides global/per-game RTP for this player across all games."
    },
    "staked_amount": {
      "type": "number",
      "default": 0,
      "description": "Balance currently locked in the Stack (cannot be used or withdrawn until it unlocks)"
    },
    "staked_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the current Stack lock started"
    },
    "last_profit_claim": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last claimed Stack profit day"
    },
    "wager_remaining": {
      "type": "number",
      "default": 0,
      "description": "Deposited funds still requiring play-through (bets or stacking) before withdrawal is allowed. Decremented by game bets and stacking; cleared to 0 once the deposited amount has been wagered or staked."
    },
    "promo_code": {
      "type": "string",
      "description": "This player's unique referral promo code (shareable). New players who redeem it receive a $1 Stack bonus."
    },
    "referred_by": {
      "type": "string",
      "description": "User id of the referrer whose promo code this player redeemed. Empty until a code is used."
    },
    "promo_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this player has already redeemed a promo code for the $1 Stack bonus."
    },
    "referral_earnings": {
      "type": "number",
      "default": 0,
      "description": "Total 5% referral commission earned from referred players' deposits."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}