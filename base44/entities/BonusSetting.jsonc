{
  "name": "BonusSetting",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "signup | daily | monthly | deposit"
    },
    "label": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "deposit_percent": {
      "type": "number",
      "default": 0,
      "description": "For deposit bonus: percent of deposit awarded"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description of this bonus"
    }
  },
  "required": [
    "name"
  ]
}