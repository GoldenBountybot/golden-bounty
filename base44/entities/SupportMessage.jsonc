{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who owns this conversation thread"
    },
    "user_email": {
      "type": "string",
      "default": "",
      "description": "Email of the user for admin display"
    },
    "sender": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "bot"
      ],
      "default": "user",
      "description": "Who sent this message: user, admin, or the AI bot"
    },
    "text": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "agent_request",
        "agent_connected",
        "agent_ended"
      ],
      "default": "message",
      "description": "Control marker for the agent handoff flow. 'message' = normal chat; others mark handoff events."
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient has seen this message"
    }
  },
  "required": [
    "user_id",
    "sender",
    "text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}