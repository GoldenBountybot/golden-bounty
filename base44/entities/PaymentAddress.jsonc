{
  "name": "PaymentAddress",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "usdt",
        "crypto",
        "binance"
      ],
      "description": "Which payment method group this record belongs to"
    },
    "network": {
      "type": "string",
      "description": "Internal key, e.g. usdt_trx, btc, binance_qr"
    },
    "label": {
      "type": "string",
      "description": "Display name shown to users"
    },
    "address": {
      "type": "string",
      "description": "Wallet address (for usdt/crypto). Empty for QR-only binance."
    },
    "qr_image_url": {
      "type": "string",
      "description": "QR code image URL (used by binance pay view)"
    },
    "symbol": {
      "type": "string",
      "description": "Coin/logo symbol badge letter, e.g. \u20ae, \u20bf, \u039e"
    },
    "color": {
      "type": "string",
      "description": "Hex color for the coin logo badge"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description of this payment address"
    }
  },
  "required": [
    "method",
    "network",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}